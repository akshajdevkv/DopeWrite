GROQ_API_KEY=your-key-here
GROQ_MODEL=openai/gpt-oss-20b
FRONTEND_ORIGIN=http://localhost:3000
# Local PDF OCR (install tesseract first); additional languages need traineddata.
TESSERACT_CMD=tesseract
OCR_LANGUAGES=eng

# Required for paid study APIs when Supabase authentication is configured.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_PRODUCT_ID=your-product-id
# Set NODE_ENV=production for live-only payment access on a production backend.
# For production also set DODO_PAYMENTS_ENVIRONMENT=live_mode and use the exact
# live product ID configured on the frontend. Test mode never grants live access.
